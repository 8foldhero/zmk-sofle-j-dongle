#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    new_behavior: new_behavior {
        compatible = "zmk,behavior-hold-tap";
        label = "NEW_BEHAVIOR";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <110>;
        hold-trigger-key-positions = <57 0>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

        combo_profile_press {
            bindings = <&tog 2>;
            key-positions = <60 56>;
        };

        ToLayerQWERTY {
            bindings = <&tog 0>;
            key-positions = <1 56>;
        };

        ToLayerNUMPAD {
            bindings = <&to 1>;
            key-positions = <2 56>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&new_behavior TILDE ESCAPE  &kp N1     &kp N2    &kp N3        &kp N4  &kp N5       &kp UP       &kp N6     &kp N7  &kp N8     &kp N9     &kp N0    &kp BSPC
&kp TAB                     &kp Q      &kp W     &kp E         &kp R   &kp T        &kp DOWN     &kp Y      &kp U   &kp I      &kp O      &kp P     &kp MINUS
&kp CAPS                    &kp A      &kp S     &kp D         &kp F   &kp G        &kp LEFT     &kp H      &kp J   &kp K      &kp L      &kp SEMI  &kp SQT
&kp LSHFT                   &kp Z      &kp X     &kp C         &kp V   &kp B        &kp RIGHT    &kp N      &kp M   &kp COMMA  &kp DOT    &kp FSLH  &kp RET
&kp K_MUTE                  &kp LCTRL  &kp LGUI  &kp LEFT_ALT  &tog 1  &kp SPACE    &kp K_MUTE2  &kp SPACE  &tog 3  &tog 2     &kp EQUAL  &kp DEL
            >;

            display-name = "QWERTY";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        L.NUM {
            bindings = <
&kp F13  &kp F14    &kp F15          &kp F16    &kp F17          &kp F18          &kp UP_ARROW     &kp GRAVE  &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&kp F19  &kp F20    &kp KP_NUMBER_7  &kp KP_N8  &kp KP_N9        &kp PAGE_UP      &kp DOWN         &trans     &trans  &trans  &trans            &trans             &trans
&kp F21  &kp F22    &kp KP_NUMBER_4  &kp KP_N5  &kp KP_NUMBER_6  &kp HOME         &kp LEFT_ARROW   &trans     &trans  &trans  &trans            &trans             &trans
&kp F23  &kp F24    &kp KP_NUMBER_1  &kp KP_N2  &kp KP_N3        &kp PAGE_DOWN    &kp RIGHT_ARROW  &trans     &trans  &trans  &trans            &kp BSLH           &trans
&trans   &kp KP_N0  &kp KP_DOT       &kp RET    &trans           &kp SPACE        &trans           &trans     &trans  &trans  &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT_BRACKET RIGHT_BRACKET>;
            label = "L NUM";
        };

        FUNCT {
            bindings = <
&kp GRAVE    &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &mmv MOVE_UP     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &trans
&sys_reset   &bt BT_CLR       &bt BT_CLR_ALL  &mkp MCLK        &mkp RCLK        &mkp MB4           &mmv MOVE_DOWN   &kp PG_UP        &kp END          &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
&bootloader  &out OUT_USB     &out OUT_BLE    &trans           &trans           &mkp MB5           &mmv MOVE_LEFT   &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans       &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT  &kp F11    &kp F12           &trans
&kp C_MUTE   &trans           &trans          &trans           &trans           &trans             &mkp LCLK        &trans           &trans           &trans      &trans     &trans
            >;

            display-name = "FUNCTION";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        R.NUM {
            bindings = <
&trans          &trans     &trans  &trans        &trans  &trans    &trans  &trans  &kp KP_MINUS     &kp KP_PLUS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans          &trans     &trans  &trans        &trans  &trans    &trans  &trans  &kp KP_N7        &kp KP_N8    &kp KP_N9         &trans             &trans
&trans          &trans     &trans  &trans        &trans  &trans    &trans  &trans  &kp KP_N4        &kp KP_N5    &kp KP_N6         &trans             &trans
&kp LEFT_SHIFT  &trans     &trans  &trans        &trans  &trans    &trans  &trans  &kp KP_NUMBER_1  &kp KP_N2    &kp KP_NUMBER_3   &trans             &trans
&trans          &kp LCTRL  &trans  &kp LEFT_ALT  &trans  &trans    &trans  &trans  &trans           &kp KP_N0    &kp KP_DOT        &trans
            >;
        };
    };
};
