#define ZMK_POINTING_DEFAULT_MOVE_VAL 700  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <600>;
};

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;     // 300
    delay-ms = <0>;                   // 0
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    new_behavior: new_behavior {
        compatible = "zmk,behavior-hold-tap";
        label = "NEW_BEHAVIOR";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
        hold-trigger-key-positions = <0>;
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            display-name = "Zero";
            bindings = <
&new_behavior TILDE ESCAPE  &kp N1     &kp N2    &kp N3        &kp N4  &kp N5       &kp UP       &kp N6     &kp N7  &kp N8     &kp N9     &kp N0    &kp BSPC
&kp TAB                     &kp Q      &kp W     &kp E         &kp R   &kp T        &kp DOWN     &kp Y      &kp U   &kp I      &kp O      &kp P     &kp MINUS
&kp CAPS                    &kp A      &kp S     &kp D         &kp F   &kp G        &kp LEFT     &kp H      &kp J   &kp K      &kp L      &kp SEMI  &kp SQT
&kp LSHFT                   &kp Z      &kp X     &kp C         &kp V   &kp B        &kp RIGHT    &kp N      &kp M   &kp COMMA  &kp DOT    &kp FSLH  &kp RET
&kp K_MUTE                  &kp LCTRL  &kp LGUI  &kp LEFT_ALT  &tog 1  &kp SPACE    &kp K_MUTE2  &kp SPACE  &tog 4  &tog 3     &kp EQUAL  &kp DEL
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_1 {
            display-name = "L-1";
            bindings = <
&kp F13  &kp F14    &kp F15          &kp F16    &kp F17          &kp F18          &kp UP_ARROW     &kp GRAVE  &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&kp F19  &kp F20    &kp KP_NUMBER_7  &kp KP_N8  &kp KP_N9        &kp PAGE_UP      &kp DOWN         &trans     &trans  &trans  &trans            &trans             &trans
&kp F21  &kp F22    &kp KP_NUMBER_4  &kp KP_N5  &kp KP_NUMBER_6  &kp HOME         &kp LEFT_ARROW   &trans     &trans  &trans  &trans            &trans             &trans
&kp F23  &kp F24    &kp KP_NUMBER_1  &kp KP_N2  &kp KP_N3        &kp PAGE_DOWN    &kp RIGHT_ARROW  &trans     &trans  &trans  &trans            &kp BSLH           &trans
&trans   &kp KP_N0  &kp KP_DOT       &kp RET    &trans           &kp SPACE        &trans           &trans     &trans  &trans  &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_2 {
            display-name = "L-2";
            bindings = <
&trans          &trans     &trans  &trans        &trans  &trans    &trans  &trans  &kp KP_MINUS     &kp KP_PLUS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans          &trans     &trans  &trans        &trans  &trans    &trans  &trans  &kp KP_N7        &kp KP_N8    &kp KP_N9         &trans             &trans
&trans          &trans     &trans  &trans        &trans  &trans    &trans  &trans  &kp KP_N4        &kp KP_N5    &kp KP_N6         &trans             &trans
&kp LEFT_SHIFT  &trans     &trans  &trans        &trans  &trans    &trans  &trans  &kp KP_NUMBER_1  &kp KP_N2    &kp KP_NUMBER_3   &trans             &trans
&trans          &kp LCTRL  &trans  &kp LEFT_ALT  &trans  &trans    &trans  &trans  &trans           &kp KP_N0    &kp KP_DOT        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_3 {
            display-name = "Kbd Conf";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &rgb_ug RGB_COLOR_HSB(0,100,50)  &rgb_ug RGB_COLOR_HSB(29,100,50)  &rgb_ug RGB_COLOR_HSB(59,100,50)  &rgb_ug RGB_COLOR_HSB(118,100,50)  &rgb_ug RGB_COLOR_HSB(232,100,50)  &rgb_ug RGB_COLOR_HSB(272,100,50)
&bt BT_CLR      &none         &none         &none         &none         &out OUT_BLE    &none  &rgb_ug RGB_ON                   &rgb_ug RGB_BRI                   &rgb_ug RGB_SPI                   &rgb_ug RGB_EFR                    &rgb_ug RGB_SAI                    &rgb_ug RGB_HUI
&bt BT_CLR_ALL  &none         &none         &none         &none         &out OUT_USB    &none  &rgb_ug RGB_OFF                  &rgb_ug RGB_BRD                   &rgb_ug RGB_SPD                   &rgb_ug RGB_EFF                    &rgb_ug RGB_SAD                    &rgb_ug RGB_HUD
&soft_off       &none         &none         &none         &none         &out OUT_TOG    &none  &rgb_ug RGB_TOG                  &none                             &none                             &none                              &none                              &soft_off
&none           &sys_reset    &bootloader   &none         &trans        &none           &none  &none                            &trans                            &none                             &bootloader                        &sys_reset
            >;
        };
    };
};
